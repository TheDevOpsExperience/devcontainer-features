{
  "id": "k8s",
  "version": "1.2.0",
  "name": "Kubernetes Tools",
  "description": "kubectl, helm, kubectx, kubens — multi-arch, versions pinnable per tool",
  "documentationURL": "https://github.com/TheDevOpsExperience/devcontainer-features/tree/main/src/k8s",
  "licenseURL": "https://github.com/TheDevOpsExperience/devcontainer-features/blob/main/LICENSE",
  "installsAfter": [
    "ghcr.io/TheDevOpsExperience/devcontainer-features/core"
  ],
  "options": {
    "kubectl_version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest",
        "1.31.4"
      ],
      "description": "kubectl version (without v prefix) or latest"
    },
    "helm_version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest",
        "3.16.2"
      ],
      "description": "helm version (without v prefix) or latest"
    },
    "kubectx_version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest",
        "0.9.5"
      ],
      "description": "kubectx/kubens version (without v prefix) or latest"
    }
  },
  "mounts": [
    {
      "source": "kube-${localWorkspaceFolderBasename}",
      "target": "/dc-volumes/kube",
      "type": "volume"
    }
  ]
}