# host.env — configuration for hooks/on-init.sh, which runs on the HOST before
# the container is built. Edit these for your project.
#
# Any value can be overridden by exporting it from your shell profile (~/.zshrc),
# handy for user-specific settings like OP_ACCOUNT that differ per person.

# ── 1Password (1password feature) ────────────────────────────────────────────
# Which 1Password account holds the service account token.
# Run 'op account list' to see your accounts and their shorthands.
OP_ACCOUNT=my.1password.com

# Path to the 1Password item holding the service account token.
# Format: op://<vault>/<item>/<field>
# Quote it — item titles often contain spaces (this file is sourced by on-init.sh).
OP_SA_ITEM_PATH="op://sa-vault/SA for dev-sandbox/password"

# ── BuildKit (buildkit feature) ──────────────────────────────────────────────
# Must stay in sync with the buildkit feature options in devcontainer.json
# (daemon_host/daemon_port) and with the --network runArg.
BUILDKIT_NETWORK=devcontainer-shared
BUILDKIT_CONTAINER=buildkitd
BUILDKIT_PORT=1234
# buildkitd version (without v prefix) — keep in sync with the feature's
# "version" option so the buildctl client matches the daemon.
BUILDKIT_VERSION=latest
